/*
説明
Baby-step Giant-step
{f(x)}^N = x となる関数fに対して
{f(s)}^t = g となる最小のtを求める
f : T -> T f(x) 関数fをそのまま入れる
fm : T -> T {f(x)}^M 関数fをM回したものを入れる
O(M + N/M)
M = sqrt(N) で O(√N)
参考 https://atcoder.jp/contests/abc270/editorial/4965
verify https://atcoder.jp/contests/abc270/submissions/58147313
*/

ll n, s, k;
ll sqrt_n;
ll f(ll x){return (x + k)%n;}
ll fm(ll x){return (x + k*sqrt_n)%n;}

template<typename T>
ll bsgs(T s, T g, ll n, ll m,const function<T(T)> &f,const function<T(T)> &fm){
	map<T,ll> mp;
	for(int j = 1;j <= m;j++){
		g = f(g);
		mp[g] = j;
	}
	for(int i = 1;i <= (n + m - 1)/m;i++){
		s = fm(s);
		if(mp.count(s)) return m*i - mp[s];
	}
	return -1;
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    for(;t--;){
        cin >> n >> s >> k;
        if((n - s)%gcd(n, k) != 0) cout << -1 << '\n';
        else{
            sqrt_n = sqrt(n);
            cout << bsgs<ll>(s, 0LL, n, sqrt_n, f, fm) << '\n';
        }
    }
    return 0;
}
